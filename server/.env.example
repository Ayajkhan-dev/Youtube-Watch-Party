PORT=4000
# Frontend ka URL (CORS). Production mein Vercel URL, trailing slash nahi. Comma se kai origins bhi chalte hain.
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Production mein isse lamba random string se badlo (kabhi git mein mat daalo). Weak/dev secret production mein reject hota hai.
JWT_SECRET=dev-only-secret-change-me-123456
# Room limits (optional, ye defaults hain)
# MAX_PARTICIPANTS=100
# GRACE_PERIOD_MS=30000
# EMPTY_ROOM_TTL_MS=600000
# REQUEST_TTL_MS=60000          # approval request expiry
# REST_RATE_LIMIT_PER_MIN=60    # REST API limit per IP
# TRUST_PROXY=1                 # proxy hops (production mein default 1, local mein 0)
# Phase 13: set REDIS_URL to enable Redis room state + Socket.IO Redis adapter.
# REDIS_URL=redis://localhost:6379
# Phase 14: set MONGO_URI to enable persistent rooms + account auth.
# MONGO_URI=mongodb://localhost:27017/watch-party
# REQUIRE_AUTH=false

# Optional local-only Artillery helper. Keep false in production.
LOADTEST_QUERY_AUTH=false
LOADTEST_AUTH_TOKEN=local-only-artillery-token-change-me
